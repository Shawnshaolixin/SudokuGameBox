# =========================================================
# Unity 项目忽略规则（SudokuGameBox / GameBox）
# 忽略所有层级下的 Unity 生成目录，以兼容项目放在子目录的情况
# =========================================================

# Unity 自动生成的目录（Library/Temp/Obj/Logs 等体积大且可重建）
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Uu]ser[Ss]ettings/
[Ll]ogs/
[Bb]uild/
[Bb]uilds/

# 发布签名(Phase 7 7-3:上传密钥与证书公钥,密码纪律见 Build/keystore/README.md)
Build/keystore/
[Mm]emory[Cc]aptures/
[Rr]ecordings/
[Gg]radle/
.utmp/
[Ee]xported[Oo]bj/

# Unity 自动生成的解决方案 / 工程文件（.slnx 是 Unity 2022.2+ 的新格式）
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D 生成的 meta 对应文件（pdb/mdb 等的 meta）
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity 崩溃报告
sysinfo.txt

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics 生成文件
crashlytics-build.properties

# 打包的 Addressables 数据（任意层级）
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
# content_state.bin 必须入库（Phase 9 9-4:丢失则无法做 Content Update 增量更新,故显式放行;
# 实际产物在 [BuildTarget] 子目录:AddressableAssetsData/Android/）
!GameBox/Assets/AddressableAssetsData/Android/addressables_content_state.bin
# Addressables 构建自动生成的 link.xml(地址资源类型 preserve 白名单,每次构建重写,生成物不入库)
GameBox/Assets/AddressableAssetsData/link.xml
GameBox/Assets/AddressableAssetsData/link.xml.meta
# 远程内容构建产物(Phase 9 9-4:ServerData 为 Remote.BuildPath 输出,红线 9 不入库)
GameBox/ServerData/
GameBox/ServerData.meta

# 临时自动生成的 Android 资源（任意层级）
**/[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
**/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*

# Unity AI Assistant 本地设置（可能含个人配置）
com.unity.ai.assistant/

# 本地 MCP 服务器配置（含本机绝对路径，个人环境使用）
.mcp.json

# =========================================================
# 文档治理（docs/11_… §16 D-10）：调研原文与历史备份不入库
# 注：docs/10_* 已入库（2026-08-21 拍板：10 文档已从调研原文重写为权威执行手册）
# =========================================================
_private/

# =========================================================
# IDE / 编辑器
# =========================================================
.vs/
.vscode/
.idea/
*.swp
*.swo

# =========================================================
# 操作系统文件
# =========================================================
.DS_Store
Thumbs.db
desktop.ini

# =========================================================
# 其他临时文件
# =========================================================
*.log
*.tmp
*.bak

# CLI 测试输出（EditMode/PlayMode 结果 xml 与日志，不入库）
[Tt]est[Rr]esults/

# =========================================================
# codely-cli(本地配置/自动存档/生成文档,个人环境不入库)
# =========================================================
.codely-cli/
CODELY.md

# =========================================================
# Unity 本地生成/恢复产物(可重建,不入库)
# =========================================================
# Addressables 代码生成目录
GameBox/Assets/GeneratedLocalRepo/
GameBox/Assets/GeneratedLocalRepo.meta
# 编辑器崩溃恢复目录
GameBox/Assets/_Recovery/
GameBox/Assets/_Recovery.meta
# External Dependency Manager 解析产物(Firebase aar,构建时自动生成)
GameBox/Assets/Plugins/Android/FirebaseApp.androidlib/
GameBox/Assets/Plugins/Android/FirebaseCrashlytics.androidlib/
GameBox/Assets/Plugins/Android/*.androidlib.meta

# HybridCLR 生成目录(Phase 9 9-1:Install 注入的 il2cpp 运行时 + GenerateAll 产物,可重跑生成,不入库)
GameBox/HybridCLRData/
GameBox/Assets/HybridCLRGenerate/
GameBox/Assets/HybridCLRGenerate.meta

# =========================================================
# 素材中间产物与本地备份(不入库)
# =========================================================
_art_originals_backup/
rovilo_slices/
rovilo_ui_layers/

# =========================================================
# Phase 9 9-4 热更远程内容(红线 9:仓库无远程内容,全部本地生成)
# =========================================================
# GenerateContent 产物(热更 dll/metadata/module_overrides,可重生成,不入库)
GameBox/Assets/RemoteContent/
GameBox/Assets/RemoteContent.meta
# 部署目录(deploy_remote.ps1 拷贝 ServerData 并起 http 服务)
_deploy_remote/

# Firebase 等 UPM 本地包 tgz(官方仅 tgz 分发,大体积不入库,clone 后需手动放置)
GameBox/Packages/*.tgz

# Firebase Hosting 内容目录(deploy_firebase.ps1 每次从 ServerData 重建,红线 9 不入库)
firebase-hosting/public/*/Android/
firebase-hosting/.firebase/
